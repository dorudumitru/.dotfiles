" ============================================================================
" LEADER
" ============================================================================

let mapleader = " "
let maplocalleader = "\\"

" ============================================================================
" PLUGINS
" ============================================================================

set VimEverywhere
set classtextobj
set argtextobj
set functextobj
set NERDTree
set highlightedyank
set matchit
set surround
set commentary
set which-key

" WhichKey appearance
let g:WhichKey_PrefixColor = "#c6a0f6"
let g:WhichKey_CommandColor = "#f4dbd6"
let g:WhichKey_PrefixStyle = "bold"
let g:WhichKey_KeyStyle = "italic"
let g:WhichKey_FontFamily = "JetBrains Mono Medium"
let g:WhichKey_FontSize = 12
let g:WhichKey_SortOrder = "by_key_prefix_first"
let g:WhichKey_ShowTypedSequence = "false"
let g:WhichKey_DefaultTriggers = ['<leader>', '[', ']']

" ============================================================================
" EDITOR SETTINGS
" ============================================================================

set notimeout

set showmode
set showcmd
set scrolloff=8
set sidescrolloff=8

set ignorecase
set smartcase
set incsearch
set nohlsearch

set number
set relativenumber
set visualbell

set ideajoin
set ideastatusicon=gray

set ideaeditor+=chat
set ideaeditor+=main
set ideascrollcursor

" ============================================================================
" GENERAL KEYMAPS
" ============================================================================

" Save
nnoremap <C-s> :w<CR>
inoremap <C-s> <Esc>:w<CR>
xnoremap <C-s> <Esc>:w<CR>

" Search navigation
nnoremap n nzzzv
nnoremap N Nzzzv

" Clear search highlighting
nnoremap <Esc> :nohlsearch<CR>

" Keep cursor centered while scrolling
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz

" Move selected lines
" vnoremap J :m '>+1<CR>gv=gv
" vnoremap K :m '<-2<CR>gv=gv

nnoremap <A-j> :m .+1<CR>==
nnoremap <A-k> :m .-2<CR>==

inoremap <A-j> <Esc>:m .+1<CR>==gi
inoremap <A-k> <Esc>:m .-2<CR>==gi

xnoremap <A-j> :m '>+1<CR>gv=gv
xnoremap <A-k> :m '<-2<CR>gv=gv

" Visual indentation
xnoremap < <gv
xnoremap > >gv

" Clipboard yank
nnoremap <leader>y "+y
xnoremap <leader>y "+y

" Visual paste without replacing register
xnoremap <leader>p "_dP

" ============================================================================
" WINDOW NAVIGATION
" ============================================================================

nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" ============================================================================
" BUFFER MANAGEMENT
" ============================================================================

" Previous / next buffer
nmap H <Action>(PreviousTab)
nmap L <Action>(NextTab)

" Buffer operations
nmap <leader>bb <Action>(Switcher)
nmap <leader>bd <Action>(CloseContent)
nmap <leader>bo <Action>(CloseAllEditorsButActive)
nmap <leader>bi <Action>(CloseAllUnpinnedEditors)
nmap <leader>bD <Action>(CloseAllEditors)
nmap <leader>bp <Action>(PinActiveEditorTab)
nmap <leader>bP <Action>(CloseAllUnpinnedEditors)

" ============================================================================
" FILE NAVIGATION
" ============================================================================

" Find
nmap <leader><space> <Action>(GotoFile)
nmap <leader>fr <Action>(RecentFiles)
nmap <leader>fc <Action>(FindInPath)
nmap <leader>fC <Action>(ReplaceInPath)
nmap <leader>fl <Action>(RecentLocations)
nmap <leader>fn <Action>(NewScratchFile)
nmap <leader>fo <Action>(OpenFile)

" Explorer: NERDTree
nnoremap <leader>e :NERDTreeToggle<CR>

" Other file operations
nmap <leader>fy <Action>(CopyAbsolutePath)
nmap <leader>fm <Action>(ManageRecentProjects)
nmap <leader>fh <Action>(LocalHistory.ShowHistory)
nmap <leader>fP <Action>(ShowFilePath)
nmap <leader>fi <Action>(SelectIn)
nmap <leader>fs <Action>(SaveAll)

" ============================================================================
" CODE NAVIGATION
" ============================================================================

nmap gd <Action>(GotoDeclaration)
nmap gD <Action>(GotoTypeDeclaration)
nmap gI <Action>(GotoImplementation)
nmap gy <Action>(GotoTypeDeclaration)

nmap gr <Action>(ShowUsages)

nmap K <Action>(QuickJavaDoc)
nmap gK <Action>(ParameterInfo)

" Hierarchies
nmap gic <Action>(CallHierarchy)
nmap goc <Action>(MethodHierarchy)

" Super method
nmap go <Action>(GotoSuperMethod)

" Tests
nmap gT <Action>(GotoTest)

" Method navigation
nmap [[ <Action>(MethodUp)
nmap ]] <Action>(MethodDown)

" Custom comment and yank
vnoremap gy ygv :Commentary<CR>

" ============================================================================
" CODE ACTIONS AND REFACTORING
" ============================================================================

nmap <leader>ca <Action>(ShowIntentionActions)
nmap <leader>cr <Action>(RenameElement)
nmap <leader>ct <Action>(Refactorings.QuickListPopupAction)

nmap <leader>cc <Action>(ChangeSignature)
nmap <leader>cv <Action>(IntroduceVariable)
nmap <leader>ci <Action>(Inline)
nmap <leader>cf <Action>(ReformatCode)
nmap <leader>cm <Action>(ExtractMethod)
nmap <leader>cC <Action>(IntroduceConstant)
nmap <leader>cp <Action>(IntroduceParameter)
nmap <leader>co <Action>(OptimizeImports)
nmap <leader>cO <Action>(IntroduceParameterObject)
nmap <leader>ce <Action>(EncapsulateFields)
nmap <leader>cI <Action>(InspectCode)
nmap <leader>cG <Action>(Generate)

" ============================================================================
" INFORMATION
" ============================================================================

nmap <leader>ie <Action>(ShowErrorDescription)
nmap <leader>it <Action>(ExpressionTypeInfo)
nmap <leader>ip <Action>(ParameterInfo)
nmap <leader>ij <Action>(QuickJavaDoc)
nmap <leader>if <Action>(FileStructurePopup)
nmap <leader>iU <Action>(ShowUmlDiagram)
nmap <leader>ih <Action>(CallHierarchy)
nmap <leader>iu <Action>(ShowUsages)
nmap <leader>im <Action>(MethodHierarchy)

" ============================================================================
" DIAGNOSTICS
" LazyVim: <leader>x
" ============================================================================

nmap ]d <Action>(GotoNextError)
nmap [d <Action>(GotoPreviousError)

nmap <leader>cd <Action>(ShowErrorDescription)
nmap <leader>xx <Action>(ActivateProblemsViewToolWindow)

" ============================================================================
" SEARCH
" ============================================================================

nmap <leader>sa <Action>(GotoAction)
nmap <leader>ss <Action>(GotoSymbol)
nmap <leader>st <Action>(TextSearchAction)
nmap <leader>su <Action>(FindUsages)
nmap <leader>sS <Action>(GotoSymbol)

" ============================================================================
" RUN AND TEST
" ============================================================================

nmap <leader>rm <Action>(RunMenu)
nmap <leader>rx <Action>(Run)
nmap <leader>rd <Action>(Debug)
nmap <leader>rn <Action>(RunClass)
nmap <leader>rc <Action>(ContextRun)
nmap <leader>rr <Action>(Rerun)
nmap <leader>rR <Action>(CompileFile)
nmap <leader>rf <Action>(RerunFailedTests)
nmap <leader>rs <Action>(Stop)
nmap <leader>rC <Action>(ChooseRunConfiguration)

" ============================================================================
" DEBUGGING
" ============================================================================

nmap <leader>dx <Action>(Debug)
nmap <leader>db <Action>(ToggleLineBreakpoint)
nmap <leader>dc <Action>(Resume)
nmap <leader>dv <Action>(ViewBreakpoints)
nmap <leader>de <Action>(EditBreakpoint)
nmap <leader>dm <Action>(XDebugger.MuteBreakpoints)

nmap <leader>dC <Action>(RunToCursor)
nmap <leader>di <Action>(StepInto)
nmap <leader>do <Action>(StepOver)
nmap <leader>dO <Action>(StepOut)
nmap <leader>dr <Action>(EvaluateExpression)
nmap <leader>dR <Action>(EvaluateExpression)
nmap <leader>dt <Action>(ActivateDebugToolWindow)

" ============================================================================
" GIT
" ============================================================================

nmap <leader>gg <Action>(Vcs.Show.Local.Changes)
nmap <leader>gb <Action>(Git.Branches)
nmap <leader>gf <Action>(Git.Fetch)
nmap <leader>gp <Action>(Vcs.Push)
nmap <leader>gP <Action>(Git.Commit.And.Push.Executor)
nmap <leader>gc <Action>(CheckinProject)
nmap <leader>gl <Action>(Vcs.Show.Log)
nmap <leader>gu <Action>(Vcs.UpdateProject)
nmap <leader>gr <Action>(Vcs.RollbackChangedLines)
nmap <leader>gt <Action>(ActivateVersionControlToolWindow)
nmap <leader>go <Action>(Github.View.Pull.Request)
nmap <leader>gm <Action>(VcsGroups)

" ============================================================================
" WINDOWS
" ============================================================================

nmap <leader>wv <Action>(SplitVertically)
nmap <leader>wh <Action>(SplitHorizontally)
nmap <leader>wu <Action>(Unsplit)
nmap <leader>wm <Action>(MoveEditorToOppositeTabGroup)

nmap <leader>wb <Action>(Back)
nmap <leader>wf <Action>(Forward)

" LazyVim-style split shortcuts
nmap <leader>- <Action>(SplitHorizontally)
nmap <leader>\| <Action>(SplitVertically)

" ============================================================================
" TAB MANAGEMENT
" ============================================================================

nmap <leader>tp <Action>(PinActiveEditorTab)
nmap <leader>tx <Action>(CloseContent)
nmap <leader>tX <Action>(CloseAllEditors)
nmap <leader>tA <Action>(CloseAllEditorsButActive)
nmap <leader>tP <Action>(CloseAllUnpinnedEditors)

" ============================================================================
" UI
" ============================================================================

nmap <leader>uz <Action>(ToggleZenMode)
nmap <leader>ud <Action>(ToggleDistractionFreeMode)
nmap <leader>uf <Action>(ToggleFullScreen)
nmap <leader>ut <Action>(ActivateProjectToolWindow)

" ============================================================================
" GENERATION AND COMPLETION
" ============================================================================

nmap <A-n> <Action>(Generate)
imap <S-CR> <Action>(EditorCompleteStatement)

